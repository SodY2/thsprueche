{
  "proverbs": [
    { "start": "Wer anderen eine Grube gräbt", "end": "fällt selbst hinein." },
    { "start": "Wer im Glashaus sitzt", "end": "sollte nicht mit Steinen werfen." },
    { "start": "Was du heute kannst besorgen", "end": "das verschiebe nicht auf morgen." },
    { "start": "Wer zuletzt lacht", "end": "lacht am besten." },
    { "start": "Wer den Pfennig nicht ehrt", "end": "ist des Talers nicht wert." },
    { "start": "Wer nicht hören will", "end": "muss fühlen." },
    { "start": "Wer A sagt", "end": "muss auch B sagen." },
    { "start": "Wer rastet", "end": "der rostet." },
    { "start": "Wer wagt", "end": "gewinnt." },
    { "start": "Wer einmal lügt", "end": "dem glaubt man nicht." },
    { "start": "Was lange währt", "end": "wird endlich gut." },
    { "start": "Wie man in den Wald hineinruft", "end": "so schallt es heraus." },
    { "start": "Wo gehobelt wird", "end": "fallen Späne." },
    { "start": "Wenn zwei sich streiten", "end": "freut sich der Dritte." },
    { "start": "Wer schön sein will", "end": "muss leiden." },
    { "start": "Wie man sich bettet", "end": "so liegt man." },
    { "start": "Der frühe Vogel", "end": "fängt den Wurm." },
    { "start": "Morgenstund", "end": "hat Gold im Mund." },
    { "start": "Aller Anfang", "end": "ist schwer." },
    { "start": "Übung", "end": "macht den Meister." },
    { "start": "Ohne Fleiß", "end": "kein Preis." },
    { "start": "Viele Köche", "end": "verderben den Brei." },
    { "start": "Kleine Geschenke", "end": "erhalten die Freundschaft." },
    { "start": "Lügen", "end": "haben kurze Beine." },
    { "start": "Hochmut", "end": "kommt vor dem Fall." },
    { "start": "Reden ist Silber", "end": "Schweigen ist Gold." },
    { "start": "Der Apfel fällt", "end": "nicht weit vom Stamm." },
    { "start": "Kleider", "end": "machen Leute." },
    { "start": "Not", "end": "macht erfinderisch." },
    { "start": "Zeit", "end": "heilt alle Wunden." },
    { "start": "Geduld", "end": "bringt Rosen." },
    { "start": "Gut Ding", "end": "will Weile haben." },
    { "start": "Ende gut", "end": "alles gut." },
    { "start": "Einem geschenkten Gaul", "end": "schaut man nicht ins Maul." },
    { "start": "Man soll den Tag", "end": "nicht vor dem Abend loben." },
    { "start": "Man soll das Eisen schmieden", "end": "solange es heiß ist." },
    { "start": "Es ist nicht alles Gold", "end": "was glänzt." },
    { "start": "Es ist noch kein Meister", "end": "vom Himmel gefallen." },
    { "start": "Eine Schwalbe", "end": "macht noch keinen Sommer." },
    { "start": "Ein Unglück", "end": "kommt selten allein." },
    { "start": "Ein blindes Huhn", "end": "findet auch mal ein Korn." },
    { "start": "Auch Rom wurde nicht", "end": "an einem Tag erbaut." },
    { "start": "Besser spät", "end": "als nie." },
    { "start": "Besser den Spatz in der Hand", "end": "als die Taube auf dem Dach." },
    { "start": "Lieber ein Ende mit Schrecken", "end": "als ein Schrecken ohne Ende." },
    { "start": "Geteiltes Leid", "end": "ist halbes Leid." },
    { "start": "Gleich und Gleich", "end": "gesellt sich gern." },
    { "start": "Gegensätze", "end": "ziehen sich an." },
    { "start": "Der Klügere", "end": "gibt nach." },
    { "start": "Der Krug geht so lange zum Brunnen", "end": "bis er bricht." },
    { "start": "Der Ton", "end": "macht die Musik." },
    { "start": "Die Hoffnung", "end": "stirbt zuletzt." },
    { "start": "Die Zeit", "end": "bringt Rat." },
    { "start": "Stille Wasser", "end": "sind tief." },
    { "start": "Bellende Hunde", "end": "beißen nicht." },
    { "start": "Neue Besen", "end": "kehren gut." },
    { "start": "Alte Liebe", "end": "rostet nicht." },
    { "start": "Liebe", "end": "geht durch den Magen." },
    { "start": "Hunger ist", "end": "der beste Koch." },
    { "start": "In der Not", "end": "frisst der Teufel Fliegen." },
    { "start": "In der Kürze", "end": "liegt die Würze." },
    { "start": "In der Ruhe", "end": "liegt die Kraft." },
    { "start": "Nach dem Regen", "end": "scheint die Sonne." },
    { "start": "Wo ein Wille ist", "end": "ist auch ein Weg." },
    { "start": "Wer zuerst kommt", "end": "mahlt zuerst." },
    { "start": "Was Hänschen nicht lernt", "end": "lernt Hans nimmermehr." }
  ]
}